# Alexandria — environment template (values match infrastructure/docker-compose.yml)

# Go API
API_ADDR=:8080
DATABASE_URL=postgres://alexandria:alexandria@localhost:5432/alexandria?sslmode=disable
NATS_URL=nats://localhost:4222
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=alexandria-dev-key
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=alexandria
S3_SECRET_KEY=alexandria-dev
S3_BUCKET=alexandria

# Friction knobs (do not weaken in production)
FRICTION_REVIEW_MIN_CHARS=150
FRICTION_NEW_ACCOUNT_DAILY_REVIEWS=2
FRICTION_TRUSTED_DAILY_REVIEWS=10
FRICTION_TRUSTED_REPUTATION=100

# Web
ALEXANDRIA_API_URL=http://localhost:8080
