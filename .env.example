# Alexandria — environment template (values match infrastructure/docker-compose.yml)

# ---- Go API -----------------------------------------------------------------
API_ADDR=:8080
DATABASE_URL=postgres://alexandria:alexandria@localhost:5432/alexandria?sslmode=disable
# Production SHOULD connect as the least-privilege role created by migration
# 0011. Superusers bypass Row-Level Security by definition, so the request path
# must never run as one.
# DATABASE_URL=postgres://alexandria_app:alexandria_app@localhost:5432/alexandria?sslmode=disable

NATS_URL=nats://localhost:4222
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=alexandria-dev-key
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=alexandria
S3_SECRET_KEY=alexandria-dev
S3_BUCKET=alexandria

# ---- Identity (WebAuthn / sessions) ------------------------------------------
# RP ID is the origin host without scheme/port; origins are the exact origins
# browsers may assert from.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Alexandria
WEBAUTHN_RP_ORIGINS=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
SESSION_SECURE_COOKIE=false
# HMAC pepper for CSRF tokens and throttle buckets. Generate per environment:
#   openssl rand -hex 32
SESSION_PEPPER=alexandria-dev-pepper-change-me
# Set true only when terminating TLS at our own edge (then X-Forwarded-For is
# trustworthy for rate-limit buckets).
TRUST_PROXY=false

# ---- Outbound email (empty SMTP_HOST ⇒ logs mail instead of sending) ---------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Alexandria <noreply@alexandria.example>

# ---- Project Gutenberg official offline catalog -------------------------------
GUTENBERG_CATALOG_URL=https://www.gutenberg.org/cache/epub/feeds/pg_catalog.csv.gz
# Set true on ONE worker to ingest the catalog in bounded batches at boot.
RUN_GUTENBERG_CATALOG=false

# ---- Friction knobs (do not weaken in production) -----------------------------
FRICTION_REVIEW_MIN_CHARS=150
FRICTION_NEW_ACCOUNT_DAILY_REVIEWS=2
FRICTION_TRUSTED_DAILY_REVIEWS=10
FRICTION_TRUSTED_REPUTATION=100

# ---- Web -----------------------------------------------------------------------
ALEXANDRIA_API_URL=http://localhost:8080

# ---- Tests ----------------------------------------------------------------------
# Integration suite runs only when this is set (see apps/api/internal/httpapi).
# ALEXANDRIA_TEST_DATABASE_URL=postgres://alexandria:alexandria@localhost:5432/alexandria?sslmode=disable
